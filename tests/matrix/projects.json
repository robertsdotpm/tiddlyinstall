{
 "notes": "Hello-world projects for the OS x runtime x mode test matrix (docs/plan.md section 3). Each prints 'hello from <runtime>'. Sent to POST /api/jobs as inline source, so no external repos are needed. {sep} is the OS path separator. {env:NAME} is the value the plan gives NAME (e.g. JAVA_HOME).",
 "projects": {
  "python": {
   "project": "hello",
   "launch": "{runtime} -m hello",
   "files": {
    "hello/__init__.py": "",
    "hello/__main__.py": "print('hello from python')\n"
   }
  },
  "node": {
   "project": "hello",
   "launch": "{runtime} {app_dir}/index.js",
   "files": {
    "index.js": "console.log('hello from node');\n"
   }
  },
  "ruby": {
   "project": "hello",
   "launch": "{runtime} {app_dir}/hello.rb",
   "files": {
    "hello.rb": "puts 'hello from ruby'\n"
   }
  },
  "php": {
   "project": "hello",
   "launch": "{runtime} {app_dir}/index.php",
   "files": {
    "index.php": "<?php echo \"hello from php\\n\";\n"
   }
  },
  "java": {
   "project": "hello",
   "install": "\"{env:JAVA_HOME}{sep}bin{sep}javac\" -d \"{app_dir}\" Hello.java",
   "launch": "{runtime} -cp {app_dir} Hello",
   "files": {
    "Hello.java": "public class Hello {\n    public static void main(String[] args) {\n        System.out.println(\"hello from java\");\n    }\n}\n"
   }
  },
  "dotnet": {
   "project": "hello",
   "launch": "{runtime} {app_dir}/bin/hello.dll",
   "files": {
    "hello.csproj": "<Project Sdk=\"Microsoft.NET.Sdk\">\n  <PropertyGroup>\n    <OutputType>Exe</OutputType>\n    <TargetFramework>net10.0</TargetFramework>\n    <AssemblyName>hello</AssemblyName>\n  </PropertyGroup>\n</Project>\n",
    "Program.cs": "System.Console.WriteLine(\"hello from dotnet\");\n"
   }
  },
  "r": {
   "project": "hello",
   "launch": "{runtime} {app_dir}/main.R",
   "files": {
    "main.R": "cat('hello from r\\n')\n"
   }
  },
  "go": {
   "project": "hello",
   "launch": "{app_dir}/hello{exe}",
   "files": {
    "go.mod": "module hello\n\ngo 1.20\n",
    "main.go": "package main\n\nimport \"fmt\"\n\nfunc main() { fmt.Println(\"hello from go\") }\n"
   }
  },
  "rust": {
   "project": "hello",
   "launch": "{app_dir}/target/release/hello{exe}",
   "files": {
    "Cargo.toml": "[package]\nname = \"hello\"\nversion = \"0.1.0\"\nedition = \"2021\"\n\n[dependencies]\n",
    "Cargo.lock": "# This file is automatically @generated by Cargo.\n# It is not intended for manual editing.\nversion = 3\n\n[[package]]\nname = \"hello\"\nversion = \"0.1.0\"\n",
    "src/main.rs": "fn main() {\n    println!(\"hello from rust\");\n}\n"
   }
  },
  "zig": {
   "project": "hello",
   "launch": "{app_dir}/hello{exe}",
   "files": {
    "main.zig": "const std = @import(\"std\");\n\npub fn main() void {\n    std.debug.print(\"hello from zig\\n\", .{});\n}\n"
   }
  },
  "nim": {
   "project": "hello",
   "launch": "{app_dir}/hello{exe}",
   "files": {
    "hello.nim": "echo \"hello from nim\"\n"
   }
  },
  "cc": {
   "project": "hello",
   "launch": "{app_dir}/hello{exe}",
   "files": {
    "hello.c": "#include <stdio.h>\n\nint main(void) {\n    puts(\"hello from cc\");\n    return 0;\n}\n"
   }
  }
 }
}