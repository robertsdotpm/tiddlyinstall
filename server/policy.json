  },
  "dotnet": {
   "label": ".NET",
   "variants": [
    "sdk"
   ],
   "only": true,
   "formats": {
    "windows": [
     "zip"
    ],
    "linux": [
     "tar.gz"
    ],
    "macos": [
     "tar.gz"
    ]
   },
   "kinds": [
    "archive"
   ],
   "compiled": true,
   "launch": "{runtime} {app_dir}/bin/{project}.dll",
   "package": {
    "_comment": "A .NET tool from NuGet, installed with --tool-path into the app's folder; its launcher finds the private runtime through DOTNET_ROOT (recipe launch env). No lookup: NuGet's API doesn't name a tool's command, so launch assumes the package id and the version isn't pinned unless the publisher gives one.",
    "registry": "NuGet",
    "name": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$",
    "spec": "\"{name}\" --version \"{version}\"",
    "spec_any": "\"{name}\"",
    "install": {
     "windows": "\"{runtime}\" tool install --tool-path \"{app_dir}\\bin\" {package}",
     "linux": "\"{runtime}\" tool install --tool-path \"{app_dir}/bin\" {package}",
     "macos": "\"{runtime}\" tool install --tool-path \"{app_dir}/bin\" {package}"
    },
    "launch": "{app_dir}/bin/{bin}{exe}"
   }
  },
  "r": {
   "label": "R",
   "variants": [
    "",
    "posit-ubuntu-2204"
   ],
   "formats": {
    "windows": [
     "exe"
    ],
    "linux": [
     "deb"
    ],
    "macos": [
     "pkg"
    ]
   },
   "launch": "{runtime} {app_dir}/main.R"
  },
  "go": {
   "label": "Go",
   "variants": [
    ""
   ],
   "only": true,
   "formats": {
    "windows": [
     "zip"
    ],
    "linux": [
     "tar.gz"
    ],
    "macos": [
     "tar.gz"
    ]
   },
   "kinds": [
    "archive"
   ],
   "compiled": true,
   "launch": "{app_dir}/{project}{exe}",
   "package": {
    "_comment": "go install <module path>@<version> with GOBIN in the app's folder; the program is named after the path's last element. No lookup: the module proxy only knows module roots, not package paths inside them, so an unpinned record installs @latest at install time.",
    "registry": "the Go module proxy",
    "name": "^[a-z0-9][a-z0-9.-]*\\.[a-z]{2,}(/[A-Za-z0-9._~-]+)+$",
    "spec": "\"{name}@{version}\"",
    "spec_any": "\"{name}@latest\"",
    "project_from": "last",
    "install": {
     "windows": "\"{runtime_dir}\\bin\\go.exe\" install {package}",
     "linux": "\"{runtime_dir}/bin/go\" install {package}",
     "macos": "\"{runtime_dir}/bin/go\" install {package}"
    },
    "ienv": {
     "windows": {"GOBIN": "{app_dir}"},
     "linux": {"GOBIN": "{app_dir}"},
     "macos": {"GOBIN": "{app_dir}"}
    },
    "launch": "{app_dir}/{project}{exe}"
   }
  },
  "rust": {
   "label": "Rust",
   "variants": [
    "gnu",
    ""
   ],
   "only": true,
   "formats": {
    "windows": [
     "tar.xz",
     "tar.gz"
    ],
    "linux": [
     "tar.xz",
     "tar.gz"
    ],
    "macos": [
     "tar.xz",
     "tar.gz"
    ]
   },
   "kinds": [
    "archive"
   ],
   "compiled": true,
   "launch": "{app_dir}/target/release/{project}{exe}",
   "package": {
    "_comment": "cargo install --root into the app's folder (builds on the user's machine, design.md 1.8). crates.io names the crate's programs (bin_names), so launch runs the right one.",
    "registry": "crates.io",
    "name": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
    "lower": true,
    "spec": "\"{name}@{version}\"",
    "spec_any": "\"{name}\"",
    "lookup": "https://crates.io/api/v1/crates/{name}",
    "lookup_version": "https://crates.io/api/v1/crates/{name}/{version}",
    "version_field": "crate.max_stable_version",
    "bin_field": "version.bin_names",
    "install": {
     "windows": "\"{runtime_dir}\\bin\\cargo.exe\" install --locked --root \"{app_dir}\" {package}",
     "linux": "\"{runtime_dir}/bin/cargo\" install --locked --root \"{app_dir}\" {package}",
     "macos": "\"{runtime_dir}/bin/cargo\" install --locked --root \"{app_dir}\" {package}"
    },
    "launch": "{app_dir}/bin/{bin}{exe}"
   }
  },
  "zig": {
   "label": "Zig",
   "variants": [
    ""
   ],
   "formats": {
    "windows": [
     "zip"
    ],
    "linux": [
     "tar.xz"
    ],
    "macos": [
     "tar.xz"
    ]
   },
   "compiled": true,
   "install_command": {
    "windows": "\"{runtime_dir}\\zig.exe\" build-exe --name {project} main.zig",
    "linux": "\"{runtime_dir}/zig\" build-exe --name {project} main.zig",
    "macos": "\"{runtime_dir}/zig\" build-exe --name {project} main.zig"
   },
   "launch": "{app_dir}/{project}{exe}"
  },
  "nim": {
   "label": "Nim",
   "variants": [
    ""
   ],
   "only": true,
   "formats": {
    "windows": [
     "zip"
    ],
    "linux": [
     "tar.xz"
    ],
    "macos": [
     "tar.xz"
    ]
   },
   "kinds": [
    "archive"
   ],
   "compiled": true,
   "install_command": {
    "windows": "\"{runtime_dir}\\bin\\nim.exe\" c -d:release --nimcache:\"{data_dir}\\nimcache\" -o:\"{app_dir}\\{project}.exe\" {project}.nim",
    "linux": "\"{runtime_dir}/bin/nim\" c -d:release --nimcache:\"{data_dir}/nimcache\" -o:\"{app_dir}/{project}\" {project}.nim",
    "macos": "\"{runtime_dir}/bin/nim\" c -d:release --nimcache:\"{data_dir}/nimcache\" -o:\"{app_dir}/{project}\" {project}.nim"
   },
   "launch": "{app_dir}/{project}{exe}",
   "requires": {
    "windows": [
     {
      "runtime": "cc",
      "bin": "bin"
     }
    ]
   }
  },
  "cc": {
   "label": "C/C++",
   "variants": [
    "winlibs-posix-ucrt",
    "winlibs-posix-msvcrt",
    ""
   ],
   "only": true,
   "formats": {
    "windows": [
     "zip",
     "7z"
    ],
    "linux": [
     "tar.xz"
    ],
    "macos": [
