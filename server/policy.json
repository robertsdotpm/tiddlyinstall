    "_comment": "pip into the app's own runtime folder. Launch runs the module named like the package; publishers override it for packages whose command differs.",
    "registry": "PyPI",
    "name": "^[A-Za-z0-9]([A-Za-z0-9._-]{0,98}[A-Za-z0-9])?$",
    "lower": true,
    "spec": "\"{name}=={version}\"",
    "spec_any": "\"{name}\"",
    "lookup": "https://pypi.org/pypi/{name}/json",
    "lookup_version": "https://pypi.org/pypi/{name}/{version}/json",
    "version_field": "info.version",
    "install": {
     "windows": "\"{runtime}\" -E -s -m pip install --no-warn-script-location --disable-pip-version-check {package}",
     "linux": "\"{runtime}\" -E -s -m pip install --no-warn-script-location --disable-pip-version-check {package}",
     "macos": "\"{runtime}\" -E -s -m pip install --no-warn-script-location --disable-pip-version-check {package}"
    },
    "launch": "{runtime} -m {module}"
   }
