    "7": "==3.8.0",
    "8": "==3.8.0",
    "8.1": "==3.8.0",
    "10": "==3.13.0",
    "11": "==3.13.0"
   },
   "launch": "{runtime} -m {project}",
   "extra_files": {
    "get-pip.py": {
     "_comment": "The embeddable Windows zip has no pip; its catalogue recipe runs {tmp}\\get-pip.py. Pinned to pypa/get-pip commit f6f64415 (pip 26.2.1, 2026-08-04); bootstrap.pypa.io serves the same bytes today and is the fallback. Main get-pip.py needs 3.10+; older minors have their own.",
     "for": "install",
     "sources": [
      {"versions": "==3.5.*", "sha256": "311afebb7cdd310eb3a3a6bb6fffef53d84493db98c7cebf4008a18d3418c8be", "size": 1908223,
       "urls": ["https://raw.githubusercontent.com/pypa/get-pip/f6f644156f23dfe9acc06e7b9ca75eee311f2e37/public/3.5/get-pip.py", "https://bootstrap.pypa.io/pip/3.5/get-pip.py"]},
      {"versions": "==3.6.*", "sha256": "7e2d052458c1802dc0a9a97b98ffcc33c5e89cc203247f8e2d5451998f012092", "size": 2159254,
       "urls": ["https://raw.githubusercontent.com/pypa/get-pip/f6f644156f23dfe9acc06e7b9ca75eee311f2e37/public/3.6/get-pip.py", "https://bootstrap.pypa.io/pip/3.6/get-pip.py"]},
      {"versions": "==3.7.*", "sha256": "5b9e2f9bb476ce76f84942bb7247dec8d6c0bb9dbc8c62ba2543b81fd7a4243c", "size": 2636033,
       "urls": ["https://raw.githubusercontent.com/pypa/get-pip/f6f644156f23dfe9acc06e7b9ca75eee311f2e37/public/3.7/get-pip.py", "https://bootstrap.pypa.io/pip/3.7/get-pip.py"]},
      {"versions": "==3.8.*", "sha256": "6ed6e98282a504ee0a6632856e16c39f222d313fc38be33de216d4afb6ac12f7", "size": 2300180,
       "urls": ["https://raw.githubusercontent.com/pypa/get-pip/f6f644156f23dfe9acc06e7b9ca75eee311f2e37/public/3.8/get-pip.py", "https://bootstrap.pypa.io/pip/3.8/get-pip.py"]},
      {"versions": "==3.9.*", "sha256": "95c0ae79ccf9ac1e47e4187f49081d6ae1f45997afd4549e14f37337cbcfd766", "size": 2193444,
       "urls": ["https://raw.githubusercontent.com/pypa/get-pip/f6f644156f23dfe9acc06e7b9ca75eee311f2e37/public/3.9/get-pip.py", "https://bootstrap.pypa.io/pip/3.9/get-pip.py"]},
      {"versions": ">=3.10", "sha256": "fb24e693bab954209a063d90953621412ccad4a500905a726286e038f508ddf6", "size": 2230488,
       "urls": ["https://raw.githubusercontent.com/pypa/get-pip/f6f644156f23dfe9acc06e7b9ca75eee311f2e37/public/get-pip.py", "https://bootstrap.pypa.io/get-pip.py"]}
     ]
    }
   },
   "package": {
    "_comment": "pip into the app's own runtime folder. Launch runs the module named like the package; publishers override it for packages whose command differs.",
    "registry": "PyPI",
    "name": "^[A-Za-z0-9]([A-Za-z0-9._-]{0,98}[A-Za-z0-9])?$",
    "lower": true,
    "spec": "\"{name}=={version}\"",
    "spec_any": "\"{name}\"",
    "lookup": "https://pypi.org/pypi/{name}/json",
    "lookup_version": "https://pypi.org/pypi/{name}/{version}/json",
    "version_field": "info.version",
    "install": {
     "windows": "\"{runtime}\" -E -s -m pip install --no-warn-script-location --disable-pip-version-check {package}",
     "linux": "\"{runtime}\" -E -s -m pip install --no-warn-script-location --disable-pip-version-check {package}",
     "macos": "\"{runtime}\" -E -s -m pip install --no-warn-script-location --disable-pip-version-check {package}"
    },
    "launch": "{runtime} -m {module}"
   }
  },
  "node": {
   "label": "Node.js",
   "variants": [
    ""
   ],
   "only": true,
   "formats": {
    "windows": [
     "7z",
     "zip"
    ],
    "linux": [
     "tar.gz",
     "tar.xz"
    ],
    "macos": [
     "tar.gz",
     "tar.xz"
    ]
   },
   "kinds": [
    "archive"
   ],
   "install_files": [
    "package.json"
   ],
   "launch": "{runtime} {app_dir}",
   "package": {
    "_comment": "npm install into the app's folder (--prefix, so a package.json in a parent folder is never used). Launch runs the package's own program file from its package.json bin, with the private node, so no .cmd shims are needed on Windows. npm's cache (and its _logs) would go to ~/.npm, so ienv keeps it in the app's data folder. Scoped names (@scope/name) aren't accepted yet.",
    "registry": "npm",
    "name": "^[a-z0-9][a-z0-9._-]{0,213}$",
    "lower": true,
    "spec": "\"{name}@{version}\"",
    "spec_any": "\"{name}\"",
    "lookup": "https://registry.npmjs.org/{name}/latest",
    "lookup_version": "https://registry.npmjs.org/{name}/{version}",
    "version_field": "version",
    "bin_field": "bin",
    "install": {
     "windows": "\"{runtime}\" \"{runtime_dir}\\node_modules\\npm\\bin\\npm-cli.js\" install --prefix \"{app_dir}\" --no-audit --no-fund --no-update-notifier {package}",
     "linux": "\"{runtime}\" \"{runtime_dir}/lib/node_modules/npm/bin/npm-cli.js\" install --prefix \"{app_dir}\" --no-audit --no-fund --no-update-notifier {package}",
     "macos": "\"{runtime}\" \"{runtime_dir}/lib/node_modules/npm/bin/npm-cli.js\" install --prefix \"{app_dir}\" --no-audit --no-fund --no-update-notifier {package}"
    },
    "ienv": {
     "windows": {"npm_config_cache": "{data_dir}\\npm-cache"},
     "linux": {"npm_config_cache": "{data_dir}/npm-cache"},
     "macos": {"npm_config_cache": "{data_dir}/npm-cache"}
    },
    "launch": "{runtime} {app_dir}/node_modules/{name}/{bin_path}"
   }
  },
  "ruby": {
   "label": "Ruby",
   "variants": [
    "",
    "ubuntu-22.04",
    "ubuntu-24.04",
    "macos-arm64",
    "macos-x64"
   ],
   "exclude_variants": [
    "devkit"
   ],
   "formats": {
    "windows": [
     "7z"
    ],
    "linux": [
     "tar.gz"
    ],
    "macos": [
     "tar.gz"
    ]
   },
   "kinds": [
    "archive"
   ],
   "install_files": [
    "Gemfile"
   ],
   "launch": "{runtime} {app_dir}/{project}.rb",
   "package": {
    "_comment": "gem install into GEM_HOME={app_dir}/gems (the recipe clears GEM_HOME; this sets it, for install and launch). Launch runs the gem's program named like the gem through the private ruby. RubyGems' API doesn't list a gem's programs, so publishers override launch when it differs.",
    "registry": "RubyGems",
    "name": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$",
    "spec": "\"{name}\" --version \"{version}\"",
    "spec_any": "\"{name}\"",
    "lookup": "https://rubygems.org/api/v1/gems/{name}.json",
    "version_field": "version",
    "install": {
     "windows": "\"{runtime}\" \"{runtime_dir}\\bin\\gem\" install --no-document --install-dir \"{app_dir}\\gems\" --bindir \"{app_dir}\\gems\\bin\" {package}",
     "linux": "\"{runtime}\" \"{runtime_dir}/bin/gem\" install --no-document --install-dir \"{app_dir}/gems\" --bindir \"{app_dir}/gems/bin\" {package}",
     "macos": "\"{runtime}\" \"{runtime_dir}/bin/gem\" install --no-document --install-dir \"{app_dir}/gems\" --bindir \"{app_dir}/gems/bin\" {package}"
    },
    "env": {
     "windows": {"GEM_HOME": "{app_dir}\\gems", "GEM_PATH": "{app_dir}\\gems"},
     "linux": {"GEM_HOME": "{app_dir}/gems", "GEM_PATH": "{app_dir}/gems"},
     "macos": {"GEM_HOME": "{app_dir}/gems", "GEM_PATH": "{app_dir}/gems"}
    },
    "launch": "{runtime} {app_dir}/gems/bin/{bin}"
   },
   "exclude_variants_on": {
    "macos": [
     "macos-arm64",
     "macos-x64"
    ]
   }
  },
