   "install_rules": [
    {"_comment": "npm install (the recipe's project_install).", "id": "npm", "files": ["package.json"]}
   ],
   "needs": [
    {"prerequisites": ["libatomic"], "versions": ">=25", "why": "Node.js 25 and later are linked against libatomic.so.1 (GCC's atomics library), which minimal systems such as cloud images and containers leave out."}
   ],
   "launch": "{runtime} {app_dir}",
   "package": {
    "_comment": "npm install into the app's folder (--prefix, so a package.json in a parent folder is never used). Launch runs the package's own program file from its package.json bin, with the private node, so no .cmd shims are needed on Windows. npm's cache (and its _logs) would go to ~/.npm, so ienv keeps it in the app's data folder. Scoped names (@scope/name) are accepted in jobs; the project (and the bin looked for) is the part after the slash. Plain file names can't carry them (api.md, Plans by name).",
    "registry": "npm",
    "name": "^(@[a-z0-9][a-z0-9._-]{0,100}/)?[a-z0-9][a-z0-9._-]{0,100}$",
    "lower": true,
    "project_from": "unscoped",
    "spec": "\"{name}@{version}\"",
    "spec_any": "\"{name}\"",
    "lookup": "https://registry.npmjs.org/{name}/latest",
    "lookup_version": "https://registry.npmjs.org/{name}/{version}",
    "version_field": "version",
    "bin_field": "bin",
    "install": {
     "windows": "\"{runtime}\" \"{runtime_dir}\\node_modules\\npm\\bin\\npm-cli.js\" install --prefix \"{app_dir}\" --no-audit --no-fund --no-update-notifier {package}",
     "linux": "\"{runtime}\" \"{runtime_dir}/lib/node_modules/npm/bin/npm-cli.js\" install --prefix \"{app_dir}\" --no-audit --no-fund --no-update-notifier {package}",
     "macos": "\"{runtime}\" \"{runtime_dir}/lib/node_modules/npm/bin/npm-cli.js\" install --prefix \"{app_dir}\" --no-audit --no-fund --no-update-notifier {package}"
    },
    "ienv": {
     "windows": {"npm_config_cache": "{data_dir}\\npm-cache"},
     "linux": {"npm_config_cache": "{data_dir}/npm-cache"},
     "macos": {"npm_config_cache": "{data_dir}/npm-cache"}
    },
    "launch": "{runtime} {app_dir}/node_modules/{name}/{bin_path}"
   }
  },
